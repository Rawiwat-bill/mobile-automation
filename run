#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-$ROOT/.venv/bin/python}"
ETB_SUITE="$ROOT/tests/android/etb/etb_regression.robot"
ETB_OUTPUT="$ROOT/reports/run-etb"
ETB_OUTPUT_BASE="$ETB_OUTPUT"
REAL_DEVICE_PREFLIGHT="$ROOT/tools/real_device_preflight.py"

# shellcheck source=tools/runner/android_environment.sh
source "$ROOT/tools/runner/android_environment.sh"

if [[ ! -x "$PYTHON_BIN" ]]; then
    PYTHON_BIN="${PYTHON_FALLBACK:-python3}"
fi

# Governed/non-interactive launchers may not inherit the interactive Android
# SDK PATH. Resolve only a pre-existing platform-tools directory; never install
# tools or fall back to an implicit device target.
if ! command -v adb >/dev/null 2>&1; then
    for android_sdk_root in "${ANDROID_HOME:-}" "${ANDROID_SDK_ROOT:-}" "$HOME/Library/Android/sdk"; do
        if [[ -n "$android_sdk_root" && -x "$android_sdk_root/platform-tools/adb" ]]; then
            export PATH="$android_sdk_root/platform-tools:$PATH"
            break
        fi
    done
fi

usage() {
    printf '%s\n' \
        'Usage:' \
        '  ./run etb [TC-ETB-xxx | --tag <tag> | --smoke | --dry-run]' \
        '  ./run ntb [NTB_PROFILE=<profile>]' \
        '  NTB_TESTDATA=<local-yaml> ./run ntb'
}

# shellcheck source=tools/runner/etb_runner.sh
source "$ROOT/tools/runner/etb_runner.sh"

case "${1:-}" in
    etb)
        run_etb "$@"
        ;;
    ntb)
        if [[ "$#" -ne 1 ]]; then
            printf 'NTB does not accept ETB selection options.\n' >&2
            usage >&2
            exit 2
        fi
        output="$ROOT/reports/run-ntb"
        if [[ -n "${NTB_PROFILE:-}" ]]; then
            suite="$ROOT/tests/android/onboarding/stage1_profile.robot"
            robot_args=(--variable "PROFILE:${NTB_PROFILE}")
            if [[ -n "${DEVICE_UDID:-}" ]]; then
                robot_args+=(--variable "DEVICE_UDID:${DEVICE_UDID}")
            fi
            "$PYTHON_BIN" -m robot --outputdir "$output" "${robot_args[@]}" "$suite"
        else
            suite="$ROOT/tests/android/ntb/ntb_flow.robot"
            if [[ ! -r "${NTB_TESTDATA:-}" ]]; then
                printf 'NTB runtime data is local-only and is not committed.\n' >&2
                printf 'Provide NTB_TESTDATA pointing to an approved local YAML profile file.\n' >&2
                exit 3
            fi
            "$PYTHON_BIN" -m robot --outputdir "$output" -v NTB_TESTDATA:"$NTB_TESTDATA" "$suite"
        fi
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
